{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data linked to their authenticated UID",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth user ID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User chosen display name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL or preset picture"
        },
        "preferredLanguage": {
          "type": "string",
          "description": "User preferred language code"
        },
        "preferredVoice": {
          "type": "string",
          "description": "Preferred voice name"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp ms"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last update timestamp ms"
        }
      },
      "required": ["id", "email", "displayName", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "User conversational session with Chat AI",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Conversation ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "description": "Conversation title"
        },
        "personaId": {
          "type": "string",
          "description": "Active persona ID"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp ms"
        },
        "updatedAt": {
          "type": "number",
          "description": "Update timestamp ms"
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account and profile data"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Saved conversations belonging to user"
    }
  }
}
