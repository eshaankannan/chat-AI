rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'preferredLanguage', 'preferredVoice', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 32)) &&
        (!('preferredVoice' in data) || (data.preferredVoice is string && data.preferredVoice.size() <= 32)) &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'personaId', 'createdAt', 'updatedAt', 'messages']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        (!('personaId' in data) || (data.personaId is string && data.personaId.size() <= 64)) &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Users cannot be enumerated
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(conversationId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(conversationId) && isValidConversation(request.resource.data);
        allow update: if isOwner(userId) && isValidId(conversationId) && isValidConversation(request.resource.data) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId) && isValidId(conversationId);
      }
    }
  }
}
